# Copy to .env and fill in. Never commit .env.

# Branding and public URL (used in links and emails)
COMPANY_NAME=Sterling iT
BASE_URL=https://handover.example.com.au
PORT=3000
NODE_ENV=production
# Set to 1 when running behind a reverse proxy (nginx, Azure App Service, Cloudflare)
TRUST_PROXY=1

# Encryption key for stored answers (32 bytes). Generate with: npm run gen-key
# Keep a copy somewhere safe (e.g. your password manager): lose it and stored answers can't be read.
ENCRYPTION_KEY=

# Admin portal at /admin (HTTP Basic auth). Use a long random password.
ADMIN_USER=admin
ADMIN_PASSWORD=

# Who can start a questionnaire from the home page.
# PUBLIC_START=false means customers can only use links you create in /admin.
PUBLIC_START=true
# Optional code customers must enter to start from the home page.
START_CODE=

# --- Email -------------------------------------------------------------------
# SMTP2GO:        SMTP_HOST=mail.smtp2go.com  SMTP_PORT=2525 (or 587)  SMTP_SECURE=false
# Microsoft 365:  SMTP_HOST=smtp.office365.com SMTP_PORT=587 SMTP_SECURE=false
#                 (the sending mailbox needs "Authenticated SMTP" enabled)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Handover Forms <forms@example.com.au>
# Comma-separated list of recipients for submitted questionnaires
MAIL_TO=support@example.com.au

# Leave false: passwords stay out of emailed copies and are downloaded from /admin instead.
EMAIL_INCLUDE_SECRETS=false

# Where encrypted records are stored (default ./data)
DATA_DIR=
